<h1 class="chapter-title">CHAPTER 6: CRITICAL SOURCE CODE IMPLEMENTATION (3 PAGES)</h1>

<p>This chapter presents the 3 pages of critical, production-grade source code that power the core architectural pillars of VisionAssist AI: the <strong>AI Proctoring Engine</strong>, the <strong>Speech Narration & Dictation Pipeline</strong>, and the <strong>Authentication & Data Controller API</strong>.</p>

<p>---</p>

<h3 class="subsection-title">6.1 MODULE 1: AI WEBCAM PROCTORING, SCANNED FACE LOCK & MULTI-PERSON VIOLATION STATE MACHINE</h3>
<em>File: `Frontend/src/components/StudentDashboard.jsx` (Lines 185–265)</em>

<pre class="code-block"><code class="javascript">
// ============================================================================
// VISIONASSIST AI: REAL-TIME WEBCAM PROCTORING & INTRUSION DETECTION ENGINE
// Enforces Scanned Face Verification, Absence Tolerance, and 3-Strike Auto-Exit
// ============================================================================
import React, { useRef, useState, useEffect, useCallback } from 'react';

<p>export const useAIProctoringEngine = ({ examActive, onAutoSubmitExam, speakAlert }) => {<br>  const videoRef = useRef(null);<br>  const canvasRef = useRef(null);<br>  const [violationCount, setViolationCount] = useState(0);<br>  const [proctorStatus, setProctorStatus] = useState('VERIFYING'); // 'VERIFYING'|'NORMAL'|'WARNING'|'TERMINATED'<br>  const [absenceTimer, setAbsenceTimer] = useState(0);<br>  const scannedFaceRef = useRef(null);</p>

<p>// 1. Initialize Webcam Stream<br>  useEffect(() => {<br>    let stream = null;<br>    if (examActive) {<br>      navigator.mediaDevices.getUserMedia({ video: { width: 640, height: 480, frameRate: 30 } })<br>        .then((s) => {<br>          stream = s;<br>          if (videoRef.current) videoRef.current.srcObject = s;<br>        })<br>        .catch((err) => console.error("Proctoring Camera Permission Denied:", err));<br>    }<br>    return () => {<br>      if (stream) stream.getTracks().forEach((track) => track.stop());<br>    };<br>  }, [examActive]);</p>

<p>// 2. Continuous Computer Vision Frame Evaluator<br>  const evaluateProctorFrame = useCallback(() => {<br>    if (!videoRef.current || !canvasRef.current || !examActive) return;<br>    const video = videoRef.current;<br>    const canvas = canvasRef.current;<br>    const ctx = canvas.getContext('2d');<br>    <br>    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);<br>    const frameData = ctx.getImageData(0, 0, canvas.width, canvas.height);</p>

<p>// Multi-Face Landmark & Contour Proximity Evaluation<br>    const detectedFaces = detectFaceBoundingBoxes(frameData, canvas.width, canvas.height);<br>    const faceCount = detectedFaces.length;</p>

<p>// RULE 1: Face Absence Check (5-Second Cumulative Tolerance)<br>    if (faceCount === 0) {<br>      setAbsenceTimer((prev) => {<br>        if (prev >= 5) {<br>          triggerProctorViolation("Face absent from camera frame for over 5 seconds.");<br>          return 0;<br>        }<br>        return prev + 1;<br>      });<br>    } else {<br>      setAbsenceTimer(0);<br>    }</p>

<p>// RULE 2: Multi-Person Intrusion Detection (Strict Zero-Trust Rule)<br>    if (faceCount >= 2) {<br>      triggerProctorViolation("Unauthorized second person detected in camera view!");<br>    } else if (faceCount === 1) {<br>      // RULE 3: Verify Detected Face Matches Scanned Student Profile<br>      const currentFace = detectedFaces[0];<br>      if (scannedFaceRef.current && !verifyFaceBiometrics(currentFace, scannedFaceRef.current)) {<br>        triggerProctorViolation("Face does not match registered examinee identity!");<br>      } else {<br>        setProctorStatus('NORMAL');<br>      }<br>    }<br>  }, [examActive, violationCount]);</p>

<p>// 3. 3-Strike Penalty State Machine<br>  const triggerProctorViolation = (reason) => {<br>    const nextViolation = violationCount + 1;<br>    setViolationCount(nextViolation);</p>

<p>if (nextViolation === 1) {<br>      setProctorStatus('WARNING');<br>      speakAlert("Warning 1! Proctoring alert: " + reason + " Please sit alone and face the screen.");<br>    } else if (nextViolation === 2) {<br>      setProctorStatus('WARNING');<br>      speakAlert("Final Warning 2! Proctoring alert: " + reason + " One more violation will exit your exam.");<br>    } else if (nextViolation >= 3) {<br>      setProctorStatus('TERMINATED');<br>      speakAlert("Exam terminated due to repeated proctoring violations. Your answers are being submitted.");<br>      onAutoSubmitExam({ reason: "Disqualified: Exceeded 3 Proctoring Violations", violationCount: 3 });<br>    }<br>  };</p>

<p>useEffect(() => {<br>    const proctorInterval = setInterval(evaluateProctorFrame, 1000);<br>    return () => clearInterval(proctorInterval);<br>  }, [evaluateProctorFrame]);</p>

<p>return { videoRef, canvasRef, proctorStatus, violationCount };<br>};<br></code></pre></p>

<p>---</p>

<div class="page-break"></div>

<h3 class="subsection-title">6.2 MODULE 2: CONTINUOUS VOICE RECOGNITION DICTATION & DUAL-ENGINE SPEECH SYNTHESIS</h3>
<em>File: `Frontend/src/components/HomePage.jsx` & `Frontend/src/components/StudentDashboard.jsx`</em>

<pre class="code-block"><code class="javascript">
// ============================================================================
// VISIONASSIST AI: ACCESSIBLE SPEECH SYNTHESIS & CONTINUOUS DICTATION PIPELINE
// Native SpeechRecognition Integration with Audio Queue Management
// ============================================================================
export class AccessibleAudioEngine {
  constructor() {
    this.synth = typeof window !== 'undefined' ? window.speechSynthesis : null;
    this.recognition = null;
    this.isListening = false;
    this.selectedVoice = null;
    this.initSpeechRecognition();
  }

<p>// 1. Dual-Accent Speech Synthesis Dispatcher<br>  speak(text, onEndCallback = null, rate = 1.0, pitch = 1.0) {<br>    if (!this.synth) return;<br>    this.synth.cancel(); // Terminate pending utterances to prevent overlap<br>    const utterance = new SpeechSynthesisUtterance(text);<br>    utterance.rate = rate;<br>    utterance.pitch = pitch;</p>

<p>// Prefer High-Definition Natural English Voices<br>    const voices = this.synth.getVoices();<br>    const preferredVoice = voices.find(v => v.lang.includes('en') && (v.name.includes('Natural') || v.name.includes('Google'))) || voices[0];<br>    if (preferredVoice) utterance.voice = preferredVoice;</p>

<p>utterance.onend = () => { if (onEndCallback) onEndCallback(); };<br>    utterance.onerror = (e) => console.warn("TTS Synthesis Error:", e);<br>    this.synth.speak(utterance);<br>  }</p>

<p>// 2. Real-Time Speech Recognition Engine with Silence Detection<br>  initSpeechRecognition() {<br>    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;<br>    if (!SpeechRecognition) return;<br>    this.recognition = new SpeechRecognition();<br>    this.recognition.continuous = true;<br>    this.recognition.interimResults = true;<br>    this.recognition.lang = 'en-US';<br>  }</p>

<p>startDictation(onTranscriptUpdate, onFinalResult) {<br>    if (!this.recognition || this.isListening) return;<br>    this.isListening = true;</p>

<p>this.recognition.onresult = (event) => {<br>      let interimTranscript = '';<br>      let finalTranscript = '';</p>

<p>for (let i = event.resultIndex; i < event.results.length; ++i) {<br>        if (event.results[i].isFinal) {<br>          finalTranscript += event.results[i][0].transcript;<br>        } else {<br>          interimTranscript += event.results[i][0].transcript;<br>        }<br>      }</p>

<p>if (interimTranscript) onTranscriptUpdate(interimTranscript);<br>      if (finalTranscript) onFinalResult(finalTranscript.trim());<br>    };</p>

<p>this.recognition.onerror = (event) => {<br>      if (event.error !== 'no-speech') console.warn("STT Engine Error:", event.error);<br>    };</p>

<p>try { this.recognition.start(); } catch (err) {}<br>  }</p>

<p>stopDictation() {<br>    if (this.recognition && this.isListening) {<br>      this.isListening = false;<br>      try { this.recognition.stop(); } catch (e) {}<br>    }<br>  }<br>}<br></code></pre></p>

<p>---</p>

<div class="page-break"></div>

<h3 class="subsection-title">6.3 MODULE 3: SECURE AUTHENTICATION, PASSWORD RESET WITH OTP & REST CONTROLLER PIPELINE</h3>
<em>File: `Backend/routes/authRoutes.js` & `Backend/routes/teacherRoutes.js`</em>

<pre class="code-block"><code class="javascript">
// ============================================================================
// VISIONASSIST AI: SECURE AUTHENTICATION & RESTFUL API CONTROLLERS
// Password Authentication, 2-Step OTP Recovery, and Support Ticket Pipeline
// ============================================================================
const express = require('express');
const router = express.Router();
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const { User, ContactMessage } = require('../models/TeacherModels');

<p>// 1. Password Login Controller (Unified Role Verification)<br>router.post('/login', async (req, res) => {<br>  try {<br>    const { email, password, role } = req.body;<br>    const cleanEmail = String(email || '').trim().toLowerCase();</p>

<p>// Verify User Existence<br>    const user = await User.findOne({ email: cleanEmail });<br>    if (!user) {<br>      return res.status(401).json({ success: false, message: "Invalid email or credentials." });<br>    }</p>

<p>// Role Enforcement Check<br>    if (role && user.role !== role.toLowerCase()) {<br>      return res.status(403).json({ success: false, message: `Access Denied: Account registered as ${user.role}.` });<br>    }</p>

<p>// Bcrypt Password Hash Verification<br>    const isMatch = await bcrypt.compare(password, user.password);<br>    if (!isMatch) {<br>      return res.status(401).json({ success: false, message: "Incorrect password. Please try again." });<br>    }</p>

<p>// Generate Secure JWT Session Token<br>    const token = jwt.sign({ id: user._id, email: user.email, role: user.role }, process.env.JWT_SECRET || 'vision_jwt_secret', { expiresIn: '8h' });<br>    return res.status(200).json({ success: true, message: "Login successful.", user: { username: user.username, email: user.email, role: user.role, token } });<br>  } catch (error) {<br>    return res.status(500).json({ success: false, message: "Server error during authentication." });<br>  }<br>});</p>

<p>// 2. 2-Step OTP Forgot Password Verification & Reset Pipeline<br>const activeOtpStore = new Map();</p>

<p>router.post('/send-otp', async (req, res) => {<br>  const { email } = req.body;<br>  const cleanEmail = String(email || '').trim().toLowerCase();<br>  const generatedOtp = Math.floor(100000 + Math.random() * 900000).toString(); // 6-Digit Numeric OTP</p>

<p>activeOtpStore.set(cleanEmail, { otp: generatedOtp, expiresAt: Date.now() + 10 <em> 60 </em> 1000 }); // 10 Min Expiry<br>  return res.status(200).json({ success: true, message: "Recovery OTP generated successfully.", previewOtp: generatedOtp });<br>});</p>

<p>router.post('/verify-otp', async (req, res) => {<br>  const { email, otp, newPassword } = req.body;<br>  const cleanEmail = String(email || '').trim().toLowerCase();<br>  const record = activeOtpStore.get(cleanEmail);</p>

<p>if (!record || record.otp !== String(otp).trim() || Date.now() > record.expiresAt) {<br>    return res.status(400).json({ success: false, message: "Invalid or expired recovery OTP." });<br>  }</p>

<p>// Alphanumeric Password Policy Enforcement: /^(?=.<em>[a-zA-Z])(?=.</em>[0-9])[a-zA-Z0-9]+$/<br>  if (!/^(?=.<em>[a-zA-Z])(?=.</em>[0-9])[a-zA-Z0-9]+$/.test(newPassword)) {<br>    return res.status(400).json({ success: false, message: "Password must contain letters and numbers only." });<br>  }</p>

<p>const hashedPassword = await bcrypt.hash(newPassword, 10);<br>  await User.findOneAndUpdate({ email: cleanEmail }, { password: hashedPassword });<br>  activeOtpStore.delete(cleanEmail);</p>

<p>return res.status(200).json({ success: true, message: "Password reset successful. Please log in with your new password." });<br>});</p>

<p>// 3. Support Inquiries Endpoint (Connects HomePage Contact Us to Admin Dashboard)<br>router.post('/contact-messages', async (req, res) => {<br>  const { name, email, role, subject, message } = req.body;<br>  const contactDoc = new ContactMessage({ name, email, role, subject, message, status: 'Unread' });<br>  await contactDoc.save();<br>  return res.status(201).json({ success: true, message: "Support inquiry saved.", data: contactDoc });<br>});</p>

<p>module.exports = router;<br></code></pre></p>

<p>---</p>

